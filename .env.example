# HubSpot Forms API — usado por app/api/lead/route.ts
# Como pegar: leia HUBSPOT_SETUP.md
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Meta Pixel (client-side) — instalado por components/MetaPixel.tsx
# Como pegar: Gerenciador de Eventos → seu Pixel → ID do dataset
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side, opcional mas RECOMENDADO)
# Como gerar: Gerenciador de Eventos → seu Pixel → aba "Configurações"
# → "Configurar manualmente" → "Gerar token de acesso"
META_CAPI_ACCESS_TOKEN=

# Opcional: código de teste pro painel "Testar eventos" do Meta
META_CAPI_TEST_EVENT_CODE=
